# Local (non-Docker) dev only, e.g. `npm run start:dev` against containers
# started with `docker-compose up postgres redis`. When running the api
# service itself via docker-compose, these are supplied by the root
# .env file / docker-compose.yml instead — see ../.env.example.

PORT=3000

# Must match the Postgres credentials the postgres container was started
# with (see ../.env.example) if connecting from the host.
DATABASE_URL=postgres://app:app@localhost:5432/app_dev

REDIS_URL=redis://localhost:6379

# Signs/verifies the bearer sessionToken issued at POST /players (a JWT
# scoped to a single playerId, no login step — see
# docs/api/phase1-contract.md). Dev-only placeholder secret; a real deploy
# needs a proper secret from a secrets manager (Fas 4 hardening).
JWT_SECRET=dev-only-change-me
# Base64-encoded 32-byte AES-256 key for encrypting PlayerPrivateInfo's
# parent_contact/real_name at rest (see common/crypto/pii-encryption.util.ts).
# This one is a real, valid dev-only key (generated with `openssl rand
# -base64 32`) so local dev/e2e work out of the box — never reuse it for
# anything beyond a throwaway local database.
PII_ENCRYPTION_KEY=vNO0ZD2lT5+cyQfBdv8k338mQrgoYTFtnBfGi3mlgEE=
# Optional — defaults to 180d (see AuthModule) if unset. Token
# expiry/refresh/reissue-if-lost is a backend-developer implementation
# detail per the contract, not fixed by it.
JWT_EXPIRES_IN=180d

# --- Email (SMTP) -------------------------------------------------------------
# Sends the parental-consent request email. smtp.gmail.com with a Google
# Workspace app password — NOT smtp-relay.gmail.com, which requires the
# sending IP to be allow-listed in the Workspace admin console and rejects
# otherwise ("SMTP relay isn't supported for unmanaged work accounts").
# smtp.gmail.com authenticates via SMTP_USER/SMTP_PASSWORD instead, so it
# works from any network. Leave SMTP_PASSWORD blank here; fill it in only
# in your own untracked .env, using an app password (not the account's
# normal login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.example
SMTP_PASSWORD=
SMTP_FROM=SkillStreak <noreply@yourdomain.example>
APP_PUBLIC_URL=http://localhost:3000

# Comma-separated origins allowed to call this API cross-origin (e.g. the
# site container serving the marketing page's embedded onboarding widget).
# Leave unset to disable CORS entirely — the safe default.
# CORS_ORIGIN=http://localhost:8080

# --- Video clips / MinIO (Fas 3) -----------------------------------------------
# Requires `docker-compose up minio` (or the full stack) running locally —
# see docs/adr/0010-video-storage-and-serving.md. Required, not optional
# (see env.validation.ts) — unlike SMTP, there's no clean no-op degrade for
# a feature that's fundamentally "store/serve video bytes."
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=clips
CLIP_RETENTION_DAYS=90
CLIP_PENDING_UPLOAD_TTL_MINUTES=60

# --- Staff (admin/PT) SSO/RBAC (Fas 8) -----------------------------------------
# docs/adr/0023-pt-role-and-staff-sso-rbac.md Part B. Signs the
# staff_session/staff_auth_pending cookies — a real, random secret from a
# secrets manager for anything beyond a throwaway local database, same
# posture as JWT_SECRET above (never reuse this dev-only placeholder).
STAFF_JWT_SECRET=dev-only-change-me-too
# 'true' in a real deploy with TLS; ubuntu01's own ConfigMap sets this
# 'false' (no live TLS there). Unset locally is fine — main.ts's
# ValidationPipe/env.validation.ts default this to secure=true, which is
# harmless over plain http://localhost for manual cookie inspection, just
# means the browser won't actually send it back over http.
# STAFF_COOKIE_SECURE=false
#
# Comma-separated admin email allow-list (Decision B1) — leave unset
# locally (no one is admin yet) until you have real staff accounts to
# grant.
# ADMIN_EMAILS=you@example.com
#
# OAuth client credentials — leave unset until the real OAuth applications
# are registered with each provider (Decision B6); a login attempt for an
# unconfigured provider fails with a clear error rather than the app
# refusing to boot. Use backend/src/scripts/mint-dev-staff-session.ts to
# test everything downstream of login without needing these at all.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# APPLE_OAUTH_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# --- Usage analytics / product metrics (Fas 5) ---------------------------------
# docs/adr/0020-usage-analytics-product-metrics.md — an in-process scheduled
# job that emails the project owner an AGGREGATE usage report (no per-player
# and no named-team numbers, by design). All three are optional and all three
# have safe defaults; leave them unset locally unless you're actually testing
# the report.
#
# Where the report goes (Decision 5). Unset/empty = the job no-ops with a log
# line each run, the same degrade MailService already has without SMTP.
# USAGE_REPORT_RECIPIENT_EMAIL=you@example.com
#
# Cadence (Decision 6) — a cron expression, default '0 6 1 * *' (06:00 on the
# 1st of each month). A malformed value falls back to that default rather than
# failing boot. Handy while testing: '*/5 * * * *' runs it every five minutes.
# USAGE_REPORT_CRON=0 6 1 * *
#
# Decision 3's minimum-population floor: the fewest TEAMS a team-size bucket
# must contain before the report breaks that metric out by team size at all
# (below it, those teams are counted in the app-wide number only). Default 5,
# which is the value the security review signed off on — raising it is always
# safe, anything lower is warned about on every run, and below 2 is refused
# outright.
# USAGE_REPORT_MIN_TEAMS_PER_BUCKET=5

# --- Fas 7: admin control center — error/crash + failed-job log -------------
# docs/adr/0022-admin-control-center.md Decision 6 — every unhandled
# exception, every 4xx domain error, and every failed scheduled job is
# recorded to the `error_log_entry` table (self-hosted; no Sentry, no
# external sub-processor). Rows carry no player or team reference by
# construction, and never the resolved request path, body, query string or
# headers — only the route TEMPLATE.
#
# Both knobs below are optional with safe defaults, and both are echoed by
# the admin API so the console can show the real numbers instead of
# hardcoding them. An empty or unparseable value falls back to the default
# rather than failing boot.
#
# How long a row is kept before the daily retention sweep deletes it.
# Default 90.
# ERROR_LOG_RETENTION_DAYS=90
#
# How many stack frames are kept when a row is written. Default 20.
# ERROR_LOG_STACK_MAX_FRAMES=20

# Fas 7 (docs/adr/0022-admin-control-center.md Decision 10) — where the
# admin-planning-docs ConfigMap volume is mounted. Unset locally is fine:
# the three planning views simply report themselves unavailable.
#
# In Kubernetes this is /srv/admin-planning (see k8s/api-deployment.yaml).
# Wherever it points, it must stay disjoint from any statically-served
# directory — never an ancestor or descendant of one — or the raw
# security-issues markdown becomes downloadable without passing
# AdminAuthGuard or the step-up check.
# ADMIN_PLANNING_DOCS_DIR=/srv/admin-planning

# Fas 7 — how long a bug report is kept before the daily sweep deletes it.
# Default 90 days. Sweeps by age regardless of status, deliberately: a
# retention promise an operator can defeat by never touching a report is
# not a promise. See backend/src/bug-reports/bug-reports.constants.ts.
# BUG_REPORT_RETENTION_DAYS=90

# How long a demo-event registration is kept before the daily sweep deletes
# it. Default 365 days — longer than the 90 above on purpose: a bug report
# is operational debugging data, while this is a person who asked to hear
# from us and would reasonably expect that to outlast a quarter. Swept by
# age alone, never narrowed by campaign or interest.
# EVENT_REGISTRATION_RETENTION_DAYS=365
