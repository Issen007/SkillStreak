{
  "expo": {
    "name": "SkillStreak",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.skillstreak.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "xyz.skillstreak.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-file-system",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tillåt SkillStreak att komma åt dina bilder och videor för att välja ett klipp att ladda upp.",
          "cameraPermission": "Tillåt SkillStreak att använda kameran för att spela in ett klipp.",
          "microphonePermission": "Tillåt SkillStreak att använda mikrofonen när du spelar in ett klipp."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "./plugins/withoutPushEntitlement"
    ],
    "extra": {
      "eas": {
        "projectId": "f65ba87b-0d0c-41de-a4e2-2b8fe69ad137"
      }
    },
    "owner": "issen007-team"
  }
}
