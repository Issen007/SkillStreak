# TEMPLATE — copy this file to secret.yaml and fill in real values, exactly
# like backend/.env.example -> backend/.env. `secret.yaml` (no `.example`)
# is git-ignored (see root .gitignore) specifically so this can never be
# accidentally committed with real credentials.
#
#   cp k8s/secret.yaml.example k8s/secret.yaml
#   # then edit k8s/secret.yaml with real values before applying it
#
# In CI (.github/workflows/ci-cd.yml), this file is generated at deploy
# time from individual GitHub Actions secrets (one per key below, matching
# KUBE_TOKEN/KUBE_URL) rather than a single blob — so rotating one
# credential doesn't require rewriting every other value. Every key here
# must have a matching GitHub secret of the same name.
#
# Using stringData (not the base64-encoded `data` field) so values here are
# plain text, same ergonomics as a .env file — Kubernetes base64-encodes
# them itself once applied.
apiVersion: v1
kind: Secret
metadata:
  name: skillstreak-secret
  namespace: skillstreak
type: Opaque
stringData:
  POSTGRES_PASSWORD: CHANGE_ME
  # Signs/verifies the bearer sessionToken issued at POST /players. Must be
  # a real, random secret from a secrets manager for anything beyond a
  # throwaway test cluster — never reuse the dev-only placeholder from
  # backend/.env.example.
  JWT_SECRET: CHANGE_ME
  # Fas 4 encryption-at-rest, 2026-07-28 — base64-encoded 32-byte AES-256
  # key (generate with `openssl rand -base64 32`), never the dev-only key
  # from backend/.env.example. Rotating this key requires re-running the
  # EncryptPlayerPrivateInfo migration's logic against the old key first
  # (decrypt) then the new one (re-encrypt) — there's no automatic
  # re-encryption on rotation, same manual-rotation posture this file
  # already has for JWT_SECRET.
  PII_ENCRYPTION_KEY: CHANGE_ME
  SMTP_USER: CHANGE_ME
  SMTP_PASSWORD: CHANGE_ME
  # Fas 3 (docs/adr/0010-video-storage-and-serving.md) — MinIO's root
  # credentials. Only used by minio-deployment.yaml itself (to boot the
  # server) and one-off admin tasks (mc admin ...) — the api Deployment no
  # longer uses these directly (see MINIO_CLIPS_ACCESS_KEY/SECRET_KEY
  # below), closing a real finding from the 2026-07-30 security review
  # (a compromised api process previously had full MinIO admin access,
  # not just clips-bucket access).
  MINIO_ROOT_USER: CHANGE_ME
  MINIO_ROOT_PASSWORD: CHANGE_ME
  # The api Deployment's actual MinIO credentials — a scoped, non-root user
  # (mc admin user add) with a custom least-privilege policy (mc admin
  # policy create, see k8s/README.md's MinIO section) granting only
  # ListBucket/GetBucketLocation on the `clips` bucket and
  # GetObject/PutObject/DeleteObject on `clips/*`. Never the root pair
  # above for this — that was the exact gap the 2026-07-30 review closed.
  MINIO_CLIPS_ACCESS_KEY: CHANGE_ME
  MINIO_CLIPS_SECRET_KEY: CHANGE_ME
