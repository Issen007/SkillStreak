# Copy to .env (gitignored — see the repo root .gitignore's .env/.env.*
# rule) and fill in real values. Same SMTP account/relay as the backend's
# own consent/notification emails — see k8s/secret.yaml.example's
# SMTP_USER/SMTP_PASSWORD and k8s/configmap.yaml's SMTP_HOST/SMTP_PORT/
# SMTP_FROM for the values actually in use in production; reuse them here
# rather than provisioning a second mail account for this.
#
# If this file is absent (or any of the first four vars are unset),
# check-health.sh still runs and logs to the systemd journal — it just
# skips sending an alert email. Fine for a first install; fill this in
# before relying on it to actually notify you of an outage.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=SkillStreak Uptime <noreply@isstech.io>

# Where alert emails go — almost certainly your own inbox, not a
# player/parent-facing address.
ALERT_TO=CHANGE_ME
