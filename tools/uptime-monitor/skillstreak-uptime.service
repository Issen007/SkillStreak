[Unit]
Description=Check SkillStreak's public production endpoints and email on a status change
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Absolute path assumed to match this machine's real checkout location —
# update both this and skillstreak-uptime.timer's install step if the repo
# ever lives somewhere else (same caveat as tools/local-release-poller/).
ExecStart=/home/chrisp/SkillStreak/tools/uptime-monitor/check-health.sh
# Real SMTP credentials — never committed, see .env.example in this
# directory. `EnvironmentFile=-` (leading `-`) means "don't fail the unit
# if this file doesn't exist yet" — the health checks still run and log
# without it, alert emails are just skipped (see check-health.sh's own
# send_alert guard).
EnvironmentFile=-/home/chrisp/SkillStreak/tools/uptime-monitor/.env
